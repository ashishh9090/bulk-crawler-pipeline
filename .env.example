# ==============================================================================
# Bulk Data Acquisition Pipeline Configuration
# ==============================================================================

# Global worker concurrency (bounded by asyncio.Semaphore)
CONCURRENCY_LIMIT=50

# Maximum concurrent requests per host/domain
PER_DOMAIN_CONCURRENCY=5

# HTTP request timeout in seconds
REQUEST_TIMEOUT_SECONDS=30

# Base polite delay between requests to the same domain (seconds)
RATE_LIMIT_DELAY_SECONDS=0.2

# Exponential backoff and retry settings
MAX_RETRIES=5
BACKOFF_FACTOR=1.5

# Persistence: Async SQLite with WAL mode
DATABASE_URL=sqlite+aiosqlite:///data/crawler_data.db

# Target records per type (0 = unlimited continuous crawling)
TARGET_RECORDS_PER_TYPE=1000

# Optional GitHub API Token for star extraction rate-limit elevation (5,000 req/hr)
# If left blank, uses unauthenticated GitHub API + public OpenGraph metadata fallback
GITHUB_TOKEN=

# Structured logging configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# Playwright JS Rendering flag (only instantiated when needed)
ENABLE_PLAYWRIGHT=false

# ==============================================================================
# Phase III: Multi-Tier LLM Extraction Engine Configuration
# ==============================================================================
EXTRACTION_PROVIDER_CHAIN=gemini-flash,groq-llama3,deepseek
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
EXTRACTION_MAX_RETRIES=3
EXTRACTION_TIMEOUT_MS=30000
EXTRACTION_BASE_DELAY_MS=500
EXTRACTION_MAX_DELAY_MS=10000
EXTRACTION_MAX_PAYLOAD_BYTES=250000
EXTRACTION_MAX_INPUT_TOKENS=12000
EXTRACTION_REPAIR_ATTEMPTS=1

# ==============================================================================
# Phase IV: Deterministic Entity Resolution Configuration
# ==============================================================================
ENTITY_RESOLVER_VERSION=1.0.0
ENTITY_SEED_DATA_PATH=crawler/entity_resolution/seed_data.json

# ==============================================================================
# Phase V: Anti-Bot & Scale Orchestration
# ==============================================================================
HONOR_ROBOTS_TXT=true
PLAYWRIGHT_CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_REQUEST_TIMEOUT_MS=20000
TOKEN_BUCKET_DEFAULT_RATE=5.0
TOKEN_BUCKET_DEFAULT_CAPACITY=10.0

# ==============================================================================
# Phase VI: Multi-Sheet & Google Sheets Export Configuration
# ==============================================================================
# Optional Google Sheets API authentication credentials (service account JSON string or path)
# If left blank, export saves locally to exports/intelligence_ingestion_export.xlsx and 6 CSVs
GOOGLE_SHEETS_CREDENTIALS_JSON=
GOOGLE_SHEET_ID=


[
  {
    "id": "techcrunch_ai",
    "name": "TechCrunch AI",
    "type": "news",
    "base_url": "https://techcrunch.com",
    "listing_urls": [
      "https://techcrunch.com/category/artificial-intelligence/feed/"
    ],
    "crawl_interval_minutes": 60,
    "timezone": "America/New_York",
    "locale": "en_US",
    "adapter_type": "rss",
    "selectors": {
      "article": "article",
      "title": "h1.article__title, h1.entry-title, h1",
      "body": ".article-content, .entry-content, .wp-block-post-content",
      "author": ".byline, .article__byline, [rel='author']",
      "date": "time.wp-block-post-date, time"
    },
    "date_rules": {
      "url_date_pattern": null,
      "preferred_meta": ["article:published_time", "pubdate"]
    },
    "rate_limit_delay": 0.5,
    "concurrency": 2
  },
